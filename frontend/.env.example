# Copy to .env.local for development. Never commit .env.local.
# In Vercel, set these under Project Settings → Environment Variables —
# this file is a reference, not something Vercel reads automatically.

# The Express API base. MUST include the /api mount point — the backend
# does `app.use('/api', apiRouter)`, so every route lives under it.
# Wrong:   https://api.pravasisangama.org
# Right:   https://api.pravasisangama.org/api
NEXT_PUBLIC_API_URL=http://localhost:4000/api

# The socket.io origin. Opposite of the above: NO /api suffix here —
# socket.io appends its own /socket.io path and the /live namespace.
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000
