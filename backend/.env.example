# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=4000

# PostgreSQL
DATABASE_URL=postgresql://pravasi:pravasi@localhost:5432/pravasi_sangama
PGSSL=false

# JWT — use long random values in production (openssl rand -base64 48)
JWT_SECRET=change-me-in-production
JWT_ISSUER=pravasi-sangama-2026

# Session lifetimes
UNIT_SESSION_TTL_MINUTES=720     # step 1 token — survives shift changes
AGENT_TOKEN_TTL_MINUTES=480      # step 2 token
SUPERUSER_TOKEN_TTL_MINUTES=120

# CORS — the Next.js origin
CORS_ORIGIN=http://localhost:3000

# 'none' for local dev (web on :3000, API on :4000 are different origins).
# 'lax' in production, where both sit behind one domain.
COOKIE_SAMESITE=none

# Drives "today" in analytics. Must be the event's local zone, not the server's.
EVENT_TIMEZONE=Asia/Riyadh

# SMTP — optional. Leave blank in development and emails are logged, not sent.
# Production returns 503 EMAIL_NOT_CONFIGURED rather than silently dropping.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM="Pravasi Sangama 2026 <tickets@example.org>"
